# Copiar a .env y elegir credenciales NUEVAS para esta instalación.
APP_ENV=development
HOST=127.0.0.1
PORT=3001
# Nombre comercial visible en pantallas, correos y PDF.
APP_NAME=Geo Rural
# Completar con https://mi-registro.cl al desplegar.
APP_URL=
CORS_ORIGINS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=geo_rural
DB_USER=geo_rural_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
API_WRITE_KEY=
AUTH_SESSION_HOURS=12
# auto = cookie Secure solo si HOST no es local. En producción detrás de proxy HTTPS usar always.
AUTH_COOKIE_SECURE=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Geo Rural
# admin_sia se genera solo al inicializar una base nueva.
# La clave temporal queda en .local/admin_sia.json hasta el primer cambio.
